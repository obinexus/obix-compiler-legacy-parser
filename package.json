{
  "name": "obix-compiler-legacy-parser",
  "version": "0.5.0",
  "description": "LEGACY compatibility track (D-46): the Level-0 OBIX section scanner + strict OBIX template/script parser, frozen. Produces an AST that must pass obix-spec.validateObixAST(). Depends only on obix-spec. The Vue SFC parser of the new pipeline is obix-compiler-parser.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-core-spec": "0.5.0"
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-compiler-legacy-parser.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-compiler-legacy-parser/issues"
  },
  "homepage": "https://github.com/obinexus/obix-compiler-legacy-parser#readme"
}
